# MODELO. Copie este arquivo para `.env` (sem o `.exemplo`) e preencha.
#
#   O `.env` esta no .gitignore e NUNCA vai para o GitHub.
#   Se um segredo daqui vazar, o conserto e o mesmo nos dois casos:
#   apague o app no painel da rede e crie outro. Token nao se "troca de senha".
#
# O passo a passo de onde tirar cada valor esta no README.md desta pasta.


# ---------------------------------------------------------------------------
# X  (developer.x.com)
# ---------------------------------------------------------------------------

# Do painel do app, aba "Keys and tokens" -> OAuth 2.0 Client ID and Secret.
X_CLIENT_ID=
# So preencha se o app estiver marcado como confidencial. App publico usa
# apenas PKCE e deixa esta linha vazia.
X_CLIENT_SECRET=

# Precisa estar cadastrado igualzinho em "User authentication settings" ->
# Callback URI. Se a sua conta recusar endereco http local, use o modo manual
# do autorizar.py e cadastre um endereco https que voce controle.
X_REDIRECT_URI=http://127.0.0.1:8721/callback

# Preenchidos pelo `py autorizar.py x`. Nao edite a mao.
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_EXPIRA_EM=
X_REFRESH_TOKEN=


# ---------------------------------------------------------------------------
# Instagram  (developers.facebook.com)
# ---------------------------------------------------------------------------

# Painel do app -> Instagram -> API setup with Instagram business login.
# Atencao: sao o "Instagram App ID" e o "Instagram App Secret", que nao sao
# os mesmos numeros do app do Facebook.
IG_APP_ID=
IG_APP_SECRET=

# Tem que estar identico em "Business login settings" -> Redirect URIs.
IG_REDIRECT_URI=http://127.0.0.1:8721/callback

# Preenchidos pelo `py autorizar.py instagram`. Nao edite a mao.
IG_ACCESS_TOKEN=
IG_ACCESS_TOKEN_EXPIRA_EM=
IG_USER_ID=

# Versao da Graph API usada nas chamadas.
IG_API_VERSAO=v26.0


# ---------------------------------------------------------------------------
# Midia
# ---------------------------------------------------------------------------

# O Instagram nao recebe arquivo: ele baixa a imagem deste endereco. Aponta
# para a pasta midia/ deste repositorio, que e publico.
MEDIA_BASE_URL=https://raw.githubusercontent.com/AFielDecide/plano/main/automacao/midia


# ---------------------------------------------------------------------------
# Limites (deixe vazio para usar o padrao)
# ---------------------------------------------------------------------------

# Limite de caracteres de conta comum. Se a conta virar Premium, o do X muda.
X_LIMITE_CARACTERES=280
IG_LIMITE_CARACTERES=2200
